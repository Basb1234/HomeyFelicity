{
  "name": {
    "en": "Felicity Home Battery",
    "nl": "Felicity Thuisbatterij"
  },
  "class": "battery",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "capabilities": [
    "measure_battery",
    "measure_power",
    "battery_charging_state",
    "measure_power.pv",
    "measure_power.grid",
    "measure_power.load",
    "meter_power.charged",
    "meter_power.discharged",
    "meter_power.charged_today",
    "meter_power.discharged_today",
    "meter_power.pv",
    "meter_power.pv_today",
    "meter_power.load",
    "meter_power.load_today",
    "meter_power.grid_import",
    "meter_power.grid_import_today",
    "felicity_working_mode",
    "felicity_fault_code",
    "alarm_battery",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Battery power",
        "nl": "Batterijvermogen"
      },
      "decimals": 0
    },
    "measure_power.pv": {
      "title": {
        "en": "Solar power",
        "nl": "Zonnevermogen"
      },
      "decimals": 0,
      "insights": true
    },
    "measure_power.grid": {
      "title": {
        "en": "Grid power",
        "nl": "Netvermogen"
      },
      "decimals": 0,
      "insights": true
    },
    "measure_power.load": {
      "title": {
        "en": "House load",
        "nl": "Huisverbruik"
      },
      "decimals": 0,
      "insights": true
    },
    "meter_power.charged": {
      "title": {
        "en": "Battery charged (total)",
        "nl": "Batterij geladen (totaal)"
      },
      "decimals": 2
    },
    "meter_power.discharged": {
      "title": {
        "en": "Battery discharged (total)",
        "nl": "Batterij ontladen (totaal)"
      },
      "decimals": 2
    },
    "meter_power.charged_today": {
      "title": {
        "en": "Battery charged today",
        "nl": "Batterij vandaag geladen"
      },
      "decimals": 2
    },
    "meter_power.discharged_today": {
      "title": {
        "en": "Battery discharged today",
        "nl": "Batterij vandaag ontladen"
      },
      "decimals": 2
    },
    "meter_power.pv": {
      "title": {
        "en": "Solar yield (total)",
        "nl": "Zonopbrengst (totaal)"
      },
      "decimals": 2
    },
    "meter_power.pv_today": {
      "title": {
        "en": "Solar yield today",
        "nl": "Zonopbrengst vandaag"
      },
      "decimals": 2
    },
    "meter_power.load": {
      "title": {
        "en": "House consumption (total)",
        "nl": "Huisverbruik (totaal)"
      },
      "decimals": 2
    },
    "meter_power.load_today": {
      "title": {
        "en": "House consumption today",
        "nl": "Huisverbruik vandaag"
      },
      "decimals": 2
    },
    "meter_power.grid_import": {
      "title": {
        "en": "Imported from grid (total)",
        "nl": "Van net afgenomen (totaal)"
      },
      "decimals": 2
    },
    "meter_power.grid_import_today": {
      "title": {
        "en": "Imported from grid today",
        "nl": "Vandaag van net afgenomen"
      },
      "decimals": 2
    },
    "measure_voltage.battery": {
      "title": {
        "en": "Battery voltage",
        "nl": "Batterijspanning"
      },
      "decimals": 1
    },
    "measure_current.battery": {
      "title": {
        "en": "Battery current",
        "nl": "Batterijstroom"
      },
      "decimals": 1
    },
    "measure_voltage.grid": {
      "title": {
        "en": "Grid voltage",
        "nl": "Netspanning"
      },
      "decimals": 1
    },
    "measure_frequency.grid": {
      "title": {
        "en": "Grid frequency",
        "nl": "Netfrequentie"
      },
      "decimals": 2
    },
    "measure_temperature": {
      "title": {
        "en": "Inverter temperature",
        "nl": "Omvormertemperatuur"
      },
      "decimals": 1
    },
    "alarm_generic": {
      "title": {
        "en": "Inverter fault",
        "nl": "Omvormerstoring"
      }
    },
    "alarm_battery": {
      "title": {
        "en": "Battery low",
        "nl": "Batterij laag"
      }
    }
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "connect",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "connect"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "nl": "Verbinding"
      },
      "children": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "IP address",
            "nl": "IP-adres"
          },
          "hint": {
            "en": "The address of the inverter's Modbus TCP gateway on your network.",
            "nl": "Het adres van de Modbus TCP-gateway van de omvormer in je netwerk."
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port",
            "nl": "Poort"
          },
          "value": 502,
          "min": 1,
          "max": 65535
        },
        {
          "id": "slave_id",
          "type": "number",
          "label": {
            "en": "Modbus unit ID",
            "nl": "Modbus unit-ID"
          },
          "value": 1,
          "min": 1,
          "max": 247
        },
        {
          "id": "model",
          "type": "dropdown",
          "label": {
            "en": "Inverter model",
            "nl": "Omvormermodel"
          },
          "value": "T-REX-10K-P3G01",
          "values": [
            {
              "id": "T-REX-5K-P1G01",
              "label": {
                "en": "T-REX-5K-P1G01"
              }
            },
            {
              "id": "T-REX-10K-P3G01",
              "label": {
                "en": "T-REX-10K-P3G01"
              }
            },
            {
              "id": "T-REX-25KHP3G01",
              "label": {
                "en": "T-REX-25KHP3G01"
              }
            },
            {
              "id": "T-REX-50KHP3G01",
              "label": {
                "en": "T-REX-50KHP3G01"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Polling",
        "nl": "Uitlezen"
      },
      "children": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Interval (seconds)",
            "nl": "Interval (seconden)"
          },
          "hint": {
            "en": "How often to read the inverter. Energy meters are read once a minute regardless.",
            "nl": "Hoe vaak de omvormer wordt uitgelezen. Energiemeters worden hoe dan ook eens per minuut gelezen."
          },
          "value": 10,
          "min": 5,
          "max": 600,
          "units": {
            "en": "s"
          }
        },
        {
          "id": "extended_sensors",
          "type": "checkbox",
          "label": {
            "en": "Extended sensors",
            "nl": "Uitgebreide sensoren"
          },
          "hint": {
            "en": "Also report battery voltage and current, grid voltage and frequency, and inverter temperature.",
            "nl": "Rapporteer ook batterijspanning en -stroom, netspanning en -frequentie, en omvormertemperatuur."
          },
          "value": false
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Alarms",
        "nl": "Alarmen"
      },
      "children": [
        {
          "id": "low_battery_soc",
          "type": "number",
          "label": {
            "en": "Battery low below",
            "nl": "Batterij laag onder"
          },
          "hint": {
            "en": "Turns the battery alarm on when the state of charge drops below this.",
            "nl": "Zet het batterijalarm aan als de laadtoestand hieronder zakt."
          },
          "value": 10,
          "min": 0,
          "max": 100,
          "units": {
            "en": "%"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Diagnostics",
        "nl": "Diagnose"
      },
      "children": [
        {
          "id": "last_poll",
          "type": "label",
          "label": {
            "en": "Last successful read",
            "nl": "Laatste geslaagde uitlezing"
          },
          "value": "-"
        },
        {
          "id": "last_error",
          "type": "label",
          "label": {
            "en": "Last error",
            "nl": "Laatste fout"
          },
          "value": "-"
        }
      ]
    }
  ]
}
